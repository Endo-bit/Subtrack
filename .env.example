# PostHog EU Analytics
# Get your key at: https://eu.posthog.com → Settings → Project API Key
# Copy this file to .env and fill in your key
EXPO_PUBLIC_POSTHOG_KEY=phc_YOUR_PROJECT_API_KEY_HERE

# RevenueCat (Pro paywall)
# Get your keys at: https://app.revenuecat.com → Project → API Keys
# Also create an entitlement matching utils/purchases.ts PRO_ENTITLEMENT_ID
# and an offering with its packages — the paywall reads Purchases.getOfferings().current.
# Without these set, the paywall shows "store unavailable" and the app builds/runs fine otherwise.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_YOUR_IOS_KEY_HERE
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_YOUR_ANDROID_KEY_HERE
