# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native — anchored to the repo root on purpose. A bare `ios/` matches any directory of
# that name at any depth, which silently swallowed modules/<name>/ios/, where the Expo
# Modules API requires a local module's Swift sources to live.
/ios/
/android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.rork
.env
core
node_modules
.expo
